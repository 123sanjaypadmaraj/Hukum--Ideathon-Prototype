# Copy to agents/.env (never commit the real file). Existing environment variables win.
GROQ_API_KEY=
# openai/gpt-oss-120b (best reasoning) or openai/gpt-oss-20b (faster)
HUKUM_MODEL=openai/gpt-oss-120b
# 1 = force the offline scripted LLM even when a key is set
HUKUM_OFFLINE=0
# 1 = let tools call live data sources where supported (offline data otherwise)
HUKUM_LIVE=0
GOOGLE_MAPS_API_KEY=
